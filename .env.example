# PostgreSQL (required — use Neon, Vercel Postgres, or Supabase)
# Example Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Admin login (change before production!)
ADMIN_EMAIL="admin@agtraders.com"
ADMIN_PASSWORD="use-a-strong-password-here"
ADMIN_SECRET="generate-a-long-random-string-min-32-chars"

# Payment details (defaults; editable in Admin → Payment settings)
JAZZCASH_NUMBER="0300-0000000"
EASYPAISA_NUMBER="0300-0000000"
BANK_NAME="HBL"
BANK_ACCOUNT_TITLE="AG Traders"
BANK_ACCOUNT_NUMBER="0000-0000-0000-0000"
BANK_IBAN="PK00HABB0000000000000000"
